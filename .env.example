# Reference only; the app reads process env and does not load .env automatically.
# Replace placeholders. Never commit credentials. No Azure OpenAI required.
DOCUMENTDB_HOST=<approved-cluster>.global.mongocluster.cosmos.azure.com
DOCUMENTDB_DATABASE=<approved_disposable_database>
DOCUMENTDB_COLLECTION_PREFIX=<approved_prefix>
ALLOW_DATABASE_WRITES=false
DOCUMENTDB_AUTH=native
DOCUMENTDB_USERNAME=<database-user>
DOCUMENTDB_PASSWORD=<set-securely>
# For OIDC: DOCUMENTDB_AUTH=oidc and UNSET both native credential variables.
DATA_FILE_WITH_VECTORS=data/Hotels_Vector.json
QUERY_VECTOR_FILE=data/query-vector.json
EMBEDDED_FIELD=DescriptionVector
EMBEDDING_DIMENSIONS=1536
TOP_K=5
OPERATION_TIMEOUT_SECONDS=20
SEARCH_ATTEMPTS=4
SEARCH_RETRY_DELAY_MS=1000
# Integration profile only (not default CI):
RUN_AZURE_INTEGRATION=false
